# API
PORT=8090
JWT_SECRET=change-me-in-any-shared-env
DATA_DIR=.data

# Leave DATABASE_URL unset to use in-process PGlite at $DATA_DIR/pglite
# DATABASE_URL=postgres://user:pass@host:5432/aicoach

# LLM: default is Pollinations (no API key). Set LLM_PROVIDER=stub to force offline.
# LLM_PROVIDER=pollinations
# POLLINATIONS_URL=https://text.pollinations.ai/openai
# POLLINATIONS_MODEL=openai
#
# Optional Gemini (better quality). When set, default provider becomes gemini.
# GEMINI_API_KEYS=key1,key2
# LLM_PROVIDER=gemini

# Optional S3/R2. Unset → local filesystem at $DATA_DIR/files
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=aicoach
# S3_REGION=auto

# Web
NEXT_PUBLIC_API_URL=http://localhost:8090/api
