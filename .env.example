# API — required for boot (no local DB/disk fallback)
PORT=8090
JWT_SECRET=change-me-in-any-shared-env

# Neon / Postgres (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Cloudflare R2 or any S3-compatible store (required)
# R2 endpoint form: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=aicoach-cv-files
S3_REGION=auto

# LLM — default Pollinations (no key). Optional Gemini.
# LLM_PROVIDER=pollinations
# POLLINATIONS_URL=https://text.pollinations.ai/openai
# POLLINATIONS_MODEL=openai
# GEMINI_API_KEYS=
# LLM_PROVIDER=gemini

# Web
NEXT_PUBLIC_API_URL=http://localhost:8090/api
